version 1.0;

contract Counter {
    state persistent {
        owner: address;
        count: uint256;
    }

    constructor() {
        state.owner = msg.sender;
        state.count = 0;
    }

    public getCount(): uint256 {
        return state.count;
    }

    public increment(): uint256 {
        state.count = state.count + 1;
        return state.count;
    }

    public decrement(): uint256 {
        require(state.count > 0, "Counter: Underflow protection - count is zero");
        state.count = state.count - 1;
        return state.count;
    }

    @owner
    public reset() {
        state.count = 0;
    }
}
