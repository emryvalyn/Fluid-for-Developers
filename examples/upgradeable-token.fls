version 1.0;

contract UpgradeableToken {
    state persistent {
        owner: address;
        governance: address;
        name: string;
        symbol: string;
        totalSupply: uint256;
        balances: map<address, uint256>;
        allowances: map<address, map<address, uint256>>;
        upgradeCount: uint256;
    }

    constructor(initialSupply: uint256, govAddress: address) {
        state.owner = msg.sender;
        state.governance = govAddress;
        state.name = "Upgradeable Fluid Token";
        state.symbol = "UFT";
        state.totalSupply = initialSupply;
        state.balances[msg.sender] = initialSupply;
        state.upgradeCount = 0;
    }

    public balanceOf(account: address): uint256 {
        return state.balances[account];
    }

    public transfer(to: address, amount: uint256): bool {
        require(state.balances[msg.sender] >= amount, "UFT: Insufficient balance");
        state.balances[msg.sender] = state.balances[msg.sender] - amount;
        state.balances[to] = state.balances[to] + amount;
        return true;
    }

    @governance
    public notifyUpgradeExecuted() {
        state.upgradeCount = state.upgradeCount + 1;
    }
}
