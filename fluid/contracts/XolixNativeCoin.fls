# XolixNativeCoin

```fluid
pragma fluid ^1.0;

contract XolixNativeCoin fluid {
    state persistent {
        owner: address;
        map<address, uint256> balances;
        total_supply: uint256;
    }

    transaction transfer(address to, uint256 amount)
    requires amount > 0 && balances[caller] >= amount
    {
        preflight {
            Security.require_no_reentrancy();
        }

        atomic {
            balances[caller] -= amount;
            balances[to] += amount;
        }
    }

    transaction mint(address to, uint256 amount)
    requires caller == owner && amount > 0
    {
        preflight {
            Security.require_no_reentrancy();
        }

        atomic {
            balances[to] += amount;
            total_supply += amount;
        }
    }
}
```
